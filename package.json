{
  "name": "hamyar",
  "version": "1.0.0",
  "description": "برنامه همیار",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:portable": "electron-builder --win portable --config.win.compression=maximum"
  },
  "author": "Mohammad KhanAhmadi",
  "license": "MIT",
  "build": {
    "appId": "com.hamyar.app",
    "productName": "Hamyar",
    "artifactName": "Hamyar-Portable.exe",
    "asar": true,
    "compression": "maximum",
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "Hamyar-Portable.exe"
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
